              "description": "When true, only return blocks that have tags. When false, only return blocks without tags.",
              "type": "boolean",
            },
            "method": {
              "description": "Search method: 0=keyword (default), 1=query syntax, 2=SQL, 3=regex",
              "type": "number",
            },
            "methodName": {
              "description": "Semantic alias for method: "keyword" | "query_syntax" | "sql" | "regex". The short alias "query" also maps to query syntax and overrides method when both are provided.",
              "enum": [
                "keyword",
                "query",
                "query_syntax",
                "sql",
                "regex",
              ],
              "type": "string",
            },
            "orderBy": {
              "description": "Legacy numeric sort order: 0=type, 1=created ASC, 2=created DESC, 3=updated ASC, 4=updated DESC, 5=content ASC, 6=content DESC, 7=relevance (default)",
              "type": "number",
            },
            "page": {
              "description": "Page number (1-based), default 1",
              "type": "number",
            },
            "pageSize": {
              "description": "Results per page, default 32, max 128",
              "type": "number",
            },
            "parentId": {
              "description": "Post-filter results to blocks whose root_id or parent_id matches this ID, scoping search within a document subtree.",
              "type": "string",
            },
            "paths": {
              "description": "Restrict search to specific notebook IDs or storage paths",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "query": {
              "description": "Search query string",
              "type": "string",
            },
            "sortBy": {
              "description": "Semantic sort alias: "relevance", "date", "updated_desc", "updated_asc", "created_desc", "created_asc", or "type". Overrides orderBy if both provided.",
              "enum": [
                "relevance",
                "date",
                "updated_desc",
