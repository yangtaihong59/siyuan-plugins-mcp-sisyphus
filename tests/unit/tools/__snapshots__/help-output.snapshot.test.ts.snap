              "description": "Document ID for template context",
              "type": "string",
            },
            "path": {
              "description": "Template file path inside the SiYuan workspace",
              "type": "string",
            },
            "preview": {
              "description": "When engine="template", ask SiYuan to render preview DOM instead of insertion DOM.",
              "type": "boolean",
            },
            "template": {
              "description": "Sprig template content",
              "type": "string",
            },
