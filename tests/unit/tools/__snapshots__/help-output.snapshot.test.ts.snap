            },
            "name": {
              "description": "Human-readable timeline node name",
              "minLength": 1,
              "type": "string",
            },
            "scope": {
              "description": "Create a workspace-global or document-scoped node",
              "enum": [
                "global",
                "document",
              ],
              "type": "string",
            },
          },
          "required": [
            "action",
            "name",
            "scope",
          ],
          "type": "object",
        },
        "requiredFields": [
