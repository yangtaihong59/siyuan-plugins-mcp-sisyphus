              "type": "string",
            },
            "id": {
              "description": "Document ID",
              "type": "string",
            },
          },
          "required": [
            "action",
            "id",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id",
        ],
        "tool": "file",
      },
