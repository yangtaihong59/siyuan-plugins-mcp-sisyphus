      "get_doc": {
        "action": "get_doc",
        "example": {
          "action": "get_doc",
          "id": "20240318112233-abc123",
        },
        "fullDocResource": "siyuan://help/action/document/get_doc",
        "guidance": [
          "For ordinary document file operations, prefer fs(action="ls"|"tree"|"read"|"write"|"search") because it accepts human-readable paths and hides storage paths and IDs.",
        ],
        "hint": "Use a document ID. mode="markdown" tries full clean Markdown by default, bounded to 256 KiB UTF-8 and 2000 complete blocks, with a window-scoped outline and nextWindow; totalBlocks is null until EOF; use blockStart/blockLimit/tokenBudget and optionally includeBlockIds. page/pageSize character pagination was removed. mode="html" uses the current focus view.",
        "parameters": {
          "additionalProperties": {},
          "description": "Read document Markdown in complete block windows, or return the current HTML view.",
          "properties": {
            "action": {
              "const": "get_doc",
              "type": "string",
            },
            "blockLimit": {
              "description": "Optional maximum complete display blocks in markdown mode. Omit to try full text, subject to the 256 KiB hard content limit.",
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
            "blockStart": {
              "description": "Zero-based display-block index to start reading from in markdown mode (default 0)",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "id": {
              "description": "Document ID",
              "type": "string",
            },
            "includeBlockIds": {
              "description": "Include a sidecar blockRefs mapping in markdown mode without adding block IDs to content (default false)",
              "type": "boolean",
            },
            "mode": {
              "description": "Return mode: "markdown" (default) or "html"",
              "enum": [
                "markdown",
                "html",
              ],
              "type": "string",
            },
            "size": {
              "description": "Optional maximum content size hint",
              "type": "number",
            },
            "tokenBudget": {
              "description": "Optional soft token budget for markdown. Complete blocks may exceed it, but never the 256 KiB hard content limit.",
              "maximum": 32000,
              "minimum": 1,
              "type": "integer",
            },
          },
          "required": [
            "action",
            "id",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id",
        ],
        "tool": "document",
      },
