      "query": {
        "action": "query",
        "example": {
          "action": "query",
          "page": 1,
          "pageSize": 50,
        },
        "examples": [
          {
            "mcp": {
              "action": "query",
              "page": 1,
              "pageSize": 50,
            },
            "title": "List readable documents with indexed statistics",
          },
          {
            "mcp": {
              "action": "query",
              "fields": [
                "id",
                "notebook",
                "title",
                "hpath",
                "blockCount",
              ],
              "maxBlocks": 0,
            },
            "title": "Find documents with no indexed body blocks",
          },
          {
            "mcp": {
              "action": "query",
              "duplicatesOnly": true,
              "fields": [
                "id",
                "notebook",
                "title",
                "hpath",
                "sameTitleCount",
              ],
              "sortBy": "title",
              "sortOrder": "asc",
            },
            "title": "Find same-title candidates across readable notebooks",
          },
          {
            "mcp": {
              "action": "query",
              "fields": [
                "id",
                "notebook",
                "title",
                "hpath",
                "updated",
              ],
              "hpathPrefix": "/Projects",
            },
            "title": "List only metadata under a human path",
          },
        ],
        "fullDocResource": "siyuan://help/action/document/query",
        "guidance": [
          "Use document(action="query") for paginated document metadata, indexed body-block/character counts, empty-document candidates, and same-title candidates across readable open notebooks. It works with unreadable notebooks present and does not require permission changes. Counts describe the SQL index, not native word counts or complete filesystem coverage.",
          "For ordinary document file operations, prefer fs(action="ls"|"tree"|"read"|"write"|"search") because it accepts human-readable paths and hides storage paths and IDs.",
        ],
        "hint": "Omit notebooks for all readable open notebooks, or pass notebook IDs. Explicit unreadable, unknown, or closed notebooks are rejected. fields selects metadata/stat columns; default all. title is a literal substring and hpathPrefix matches an exact notebook-local human path or descendants. Use maxBlocks=0 for no indexed body blocks, duplicatesOnly=true for same-title candidates. minBlocks/maxBlocks/minChars/maxChars are inclusive. page starts at 1; pageSize defaults to 50 (max 100). blockCount counts non-document indexed rows including containers; contentChars sums SQLite length(content), not bytes/native word count. sameTitleCount is scoped before metric filters. Read scope/excludedClosedNotebooks and index limitations; follow nextSteps for further pages. SQL fragments are not accepted.",
        "parameters": {
          "additionalProperties": false,
          "description": "Query readable open notebooks with paginated document metadata, indexed body statistics, and same-title candidates. Works while other notebooks are unreadable.",
          "properties": {
            "action": {
              "const": "query",
              "type": "string",
            },
            "duplicatesOnly": {
              "description": "Only repeated titles in scope; not proof of duplicate content.",
              "type": "boolean",
            },
            "fields": {
              "description": "Columns; default all. Statistics describe the SQL index; see query help for definitions.",
              "items": {
                "enum": [
                  "id",
                  "notebook",
                  "title",
                  "path",
                  "hpath",
                  "created",
                  "updated",
                  "blockCount",
                  "contentChars",
                  "sameTitleCount",
                ],
                "type": "string",
              },
              "maxItems": 10,
              "minItems": 1,
              "type": "array",
            },
            "hpathPrefix": {
              "description": "Exact notebook-local hpath or descendants, e.g. /Projects.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string",
            },
            "maxBlocks": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "maxChars": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "minBlocks": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "minChars": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "notebooks": {
              "description": "IDs; default readable open notebooks. Explicit unreadable/closed IDs are rejected.",
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array",
            },
            "page": {
              "description": "1-based; default 1. Pages are not a snapshot.",
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer",
            },
            "pageSize": {
              "description": "Default 50, max 100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
            "sortBy": {
              "description": "Default updated; ID breaks ties.",
              "enum": [
                "id",
                "title",
                "created",
                "updated",
                "blockCount",
                "contentChars",
                "sameTitleCount",
              ],
              "type": "string",
            },
            "sortOrder": {
              "description": "Default desc.",
              "enum": [
                "asc",
                "desc",
              ],
              "type": "string",
            },
            "title": {
              "description": "Literal case-sensitive title substring.",
              "maxLength": 512,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "action",
          ],
          "type": "object",
        },
        "requiredFields": [],
        "requiresConfirmation": false,
        "shapes": [
          "see examples",
        ],
        "tool": "document",
      },
