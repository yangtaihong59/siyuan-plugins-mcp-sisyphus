      "ensure_link_targets": {
        "action": "ensure_link_targets",
        "example": {
          "action": "ensure_link_targets",
          "mode": "resolve",
          "notebook": "20210808180117-czj9bvb",
          "parentId": "20240318112233-abc1234",
          "targets": [
            {
              "id": "20240318112233-def4567",
              "key": "source-index",
            },
          ],
        },
        "examples": [
          {
            "description": "Replace the notebook, parent, and child IDs with IDs returned by the tools. Resolve/reuse target objects contain a caller key and an existing document id; omit title.",
            "mcp": {
              "action": "ensure_link_targets",
              "mode": "resolve",
              "notebook": "20210808180117-czj9bvb",
              "parentId": "20240318112233-abc1234",
              "targets": [
                {
                  "id": "20240318112233-def4567",
                  "key": "source-index",
                },
              ],
            },
            "title": "Resolve explicit existing child IDs",
          },
          {
            "mcp": {
              "action": "ensure_link_targets",
              "mode": "reuse",
              "notebook": "20210808180117-czj9bvb",
              "parentId": "20240318112233-abc1234",
              "targets": [
                {
                  "id": "20240318112233-def4567",
                  "key": "source-index",
                },
              ],
            },
            "title": "Reuse an exact existing child ID",
          },
          {
            "description": "Create target objects contain a caller key and a new title; omit id. Preflight performs no write; commit once with the same business arguments, validateOnly=false, and the returned requestId and expectedStructureHash.",
            "mcp": {
              "action": "ensure_link_targets",
              "mode": "create",
              "notebook": "20210808180117-czj9bvb",
              "parentId": "20240318112233-abc1234",
              "targets": [
                {
                  "key": "source-index",
                  "title": "New Target",
                },
              ],
              "validateOnly": true,
            },
            "title": "Preflight creation with an explicit new title",
          },
        ],
        "fullDocResource": "siyuan://help/action/document/ensure_link_targets",
        "guidance": [
          "For ordinary document file operations, prefer fs(action="ls"|"tree"|"read"|"write"|"search") because it accepts human-readable paths and hides storage paths and IDs.",
          "document(action="ensure_link_targets") is the bounded import-link provisioner: scope it with notebook + parentId, reuse only explicit child document IDs, and use create only for explicit new titles. It never guesses an existing target from a title; same-title children are unresolved and require an ID decision.",
        ],
        "hint": "Scope every request with an explicit notebook ID and parent document ID. resolve/reuse require existing child document IDs and never fall back to titles. create accepts explicit new titles only; if a same-title child already exists, it is returned as unresolved rather than guessed or reused. dryRun performs zero writes only for create. resolve/reuse are read-only; create uses strict validateOnly preflight, then one commit with the server-issued requestId plus expectedStructureHash. Responses contain exact ID/path/HPath readback and resolved/created/reused/unresolved accounting.",
        "parameters": {
          "additionalProperties": false,
          "description": "Resolve, reuse, or create explicitly scoped direct-child document link targets. Existing targets require IDs; titles are never guessed as identities.",
          "properties": {
            "action": {
              "const": "ensure_link_targets",
              "type": "string",
            },
            "dryRun": {
              "description": "Plan and inspect the explicit scope without creating documents. For strict creation preflight, use validateOnly=true instead.",
              "type": "boolean",
            },
            "markdown": {
              "description": "Optional Markdown body for every target created by mode="create". Existing targets are never edited.",
              "type": "string",
            },
            "mode": {
              "description": "resolve/reuse accept exact existing IDs without title fallback; create accepts explicit new titles and refuses to adopt same-title children.",
              "enum": [
                "resolve",
                "reuse",
                "create",
              ],
              "type": "string",
            },
            "notebook": {
              "description": "Explicit notebook ID that must own the parent document and every returned target.",
              "minLength": 1,
              "type": "string",
            },
            "parentId": {
              "description": "Explicit parent document ID. Only direct child documents of this resolved parent are in scope.",
              "minLength": 1,
              "type": "string",
            },
            "targets": {
              "description": "Explicit link targets. keys must be unique; IDs are identities, while titles are only new-document names.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "description": "Explicit existing document ID. Required for mode="resolve" and mode="reuse".",
                    "minLength": 1,
                    "type": "string",
                  },
                  "key": {
                    "description": "Stable caller key used in the returned link map. It is not resolved as a document title.",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                  "title": {
                    "description": "Explicit title for a new direct child document. Allowed only for mode="create" and never used to adopt an existing document.",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "key",
                ],
                "type": "object",
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "action",
            "notebook",
            "parentId",
            "mode",
            "targets",
          ],
          "type": "object",
        },
        "requiredFields": [
          "notebook",
          "parentId",
          "mode",
          "targets",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "notebook + parentId + mode + targets",
        ],
        "tool": "document",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
