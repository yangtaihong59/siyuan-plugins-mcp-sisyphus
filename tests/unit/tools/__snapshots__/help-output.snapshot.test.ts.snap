      "replace": {
        "action": "replace",
        "example": {
          "action": "replace",
          "edit": "<edit>",
          "id": "20240318112233-abc123",
        },
        "fullDocResource": "siyuan://help/action/block/replace",
        "guidance": [
          "block(action="replace") only searches the kramdown of the single block identified by id. It does not traverse child blocks, sibling blocks, headings with their following content, or the whole document.",
          "Before block(action="replace"), call block(action="get_kramdown", id=...) and copy an exact old snippet from that result. It writes back through the original DOM text nodes; naked ((id)) references, footnotes, and siyuan://blocks links are allowed with backlink-semantics hints.",
          "To create real SiYuan tags inside markdown content, use the syntax #tag# with both leading and trailing # characters, then verify with tag(action="list", query="tag").",
          "To turn a block into a flashcard, prefer flashcard(action="create_card"). It writes "custom-riff-decks" and registers the riff card together.",
        ],
        "hint": "Use id + edit to replace exact text inside one block kramdown content only. First read block(action="get_kramdown", id=...) and copy old from the block body. The writeback patches original DOM text nodes, preserving inline structure while rejecting IAL metadata edits. Naked ((id)) refs are normalized; footnotes and siyuan://blocks links are allowed but do not create backlinks.",
        "parameters": {
          "additionalProperties": false,
          "description": "Apply exact old/new text replacement edits inside one block body and patch the original DOM.",
          "properties": {
            "action": {
              "const": "replace",
              "type": "string",
            },
            "edit": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "new": {
                      "description": "Replacement text. Supports multi-line strings.",
                      "type": "string",
                    },
                    "old": {
                      "description": "Original text to match exactly. Supports multi-line strings.",
                      "minLength": 1,
                      "type": "string",
                    },
                    "replace_all": {
                      "description": "When true, replace every exact match. Defaults to false.",
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "old",
                    "new",
                  ],
                  "type": "object",
                },
                {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "new": {
                        "description": "Replacement text. Supports multi-line strings.",
                        "type": "string",
                      },
                      "old": {
                        "description": "Original text to match exactly. Supports multi-line strings.",
                        "minLength": 1,
                        "type": "string",
                      },
                      "replace_all": {
                        "description": "When true, replace every exact match. Defaults to false.",
                        "type": "boolean",
                      },
                    },
                    "required": [
                      "old",
                      "new",
                    ],
                    "type": "object",
                  },
                  "minItems": 1,
                  "type": "array",
                },
              ],
              "description": "One replacement edit or an array of edits to apply sequentially within the same block kramdown",
            },
            "id": {
              "description": "Block ID",
              "type": "string",
            },
          },
          "required": [
            "action",
            "id",
            "edit",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
          "edit",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id + edit",
        ],
        "tool": "block",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
