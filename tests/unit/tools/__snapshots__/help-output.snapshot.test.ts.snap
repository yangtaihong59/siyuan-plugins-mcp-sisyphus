            "deckID": {
              "description": "Deck ID",
              "type": "string",
            },
            "mode": {
              "description": "Compatibility option. SiYuan addRiffCards writes deck attrs and registers cards in both modes.",
              "enum": [
                "full",
                "attach",
              ],
              "type": "string",
