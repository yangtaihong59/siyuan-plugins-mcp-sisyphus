        "fullDocResource": "siyuan://help/action/file/save_doc_as_template",
        "guidance": [
          "file(action="save_doc_as_template") saves an existing document as a root-level template after read-permission checks; use create_template when you need a nested template path.",
        ],
        "hint": "Use id + name to save a document as a root-level template through SiYuan’s docSaveAsTemplate API. Slashes are rejected; pass overwrite=true to replace an existing root template. Side effects: SiYuan stores the template name on the source document (custom-sy-template-export-name), and the template keeps block IALs such as fold state and custom attributes. To create a document from a template, render it with file render (relative template paths work), then append the returned DOM via block append with dataType=dom; or read_template and pass the Markdown, minus its {: id=...} lines, to document create.",
        "parameters": {
          "additionalProperties": false,
          "description": "Save an existing SiYuan document as a root-level template.",
          "properties": {
            "action": {
              "const": "save_doc_as_template",
              "type": "string",
            },
            "id": {
              "description": "Document ID to save as a root-level template.",
              "type": "string",
            },
            "name": {
              "description": "Root template name. Slashes are not supported; .md suffix is optional.",
              "type": "string",
            },
            "overwrite": {
              "description": "When true, replace an existing template with the same root name. Defaults to false.",
              "type": "boolean",
            },
          },
          "required": [
            "action",
            "id",
            "name",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
          "name",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id + name",
        ],
        "tool": "file",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
