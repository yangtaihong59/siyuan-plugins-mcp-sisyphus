              "path": "/Notebook/Folder/Doc",
            },
            "title": "Replace exact text with canonical edit object",
          },
          {
            "description": "Equivalent CLI form: siyuan-sisyphus fs replace --path "/Notebook/Folder/Doc" --old ORIGINAL_TEXT --new NEW_TEXT",
            "mcp": {
              "action": "replace",
              "new": "NEW_TEXT",
              "old": "ORIGINAL_TEXT",
              "path": "/Notebook/Folder/Doc",
              "replace_all": false,
