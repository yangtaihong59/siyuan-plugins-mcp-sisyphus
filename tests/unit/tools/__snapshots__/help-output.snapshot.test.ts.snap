      "get": {
        "action": "get",
        "example": {
          "action": "get",
          "avID": "<avID>",
        },
        "fullDocResource": "siyuan://help/action/av/get",
        "guidance": [
          "Find databases with search, inspect structure with get, query paginated records with query, then add_rows or set_cells. A database is not a Markdown table.",
          "get defaults to structure: identity, columns and view summaries, never all row IDs. scope=columns reads keys; scope=view reads exact view configuration; scope=raw preserves the complete native AV.",
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Use avID with scope=structure (default), columns, view, or raw. structure never contains row IDs or values. Optional blockID proves database context; viewID selects reading only. Use query for records.",
        "parameters": {
          "additionalProperties": false,
          "description": "Read database structure (no rows), columns, exact view configuration, or full raw AV.",
          "properties": {
            "action": {
              "const": "get",
              "type": "string",
            },
            "avID": {
              "minLength": 1,
              "type": "string",
            },
            "blockID": {
              "minLength": 1,
              "type": "string",
            },
            "scope": {
              "description": "Default structure: database identity, columns and view summaries, without rows. raw returns the complete native AV.",
              "enum": [
                "structure",
                "columns",
                "view",
                "raw",
              ],
              "type": "string",
            },
            "viewID": {
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "action",
            "avID",
          ],
          "type": "object",
        },
        "requiredFields": [
          "avID",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "avID",
        ],
        "tool": "av",
      },
      "query": {
        "action": "query",
        "example": {
          "action": "query",
          "avID": "20240318112233-abc123",
          "page": 1,
          "pageSize": 20,
        },
        "examples": [
          {
            "description": "Use get to inspect a database returned by search, then query its records.",
            "mcp": {
              "action": "query",
              "avID": "20240318112233-abc123",
              "page": 1,
              "pageSize": 20,
            },
            "title": "Query an AV returned by search",
          },
          {
            "mcp": {
              "action": "query",
              "avID": "20240318112233-abc123",
            },
            "title": "Query an existing AV",
          },
        ],
        "fullDocResource": "siyuan://help/action/av/query",
        "guidance": [
          "Find databases with search, inspect structure with get, query paginated records with query, then add_rows or set_cells. A database is not a Markdown table.",
          "query returns canonical rowID and columnID. Never substitute sourceBlockID or cell value IDs. fields projects requested stable columnIDs while always keeping rowID. mode=primary_keys returns lightweight paginated primary keys; keyword applies to either mode.",
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Use avID, optional keyword/page/pageSize/fields, and mode=rows (default) or primary_keys. fields is a list of stable columnIDs: requested cells and columns are returned and rowID is always kept. Row mode supports viewID/blockID/groupPaging. Primary-key mode rejects viewID/groupPaging/fields and defaults to 16 rows. Follow nextSteps only when present.",
        "parameters": {
          "additionalProperties": false,
          "description": "Query paginated database rows (one canonical rows[] with columnID cells and kernel formatted text) or lightweight primary keys; never creates a database. Use get(scope="raw") for the complete native payload.",
          "properties": {
            "action": {
              "const": "query",
              "type": "string",
            },
            "avID": {
              "minLength": 1,
              "type": "string",
            },
            "blockID": {
              "minLength": 1,
              "type": "string",
            },
            "fields": {
              "description": "Optional stable columnIDs to project. Row identity (rowID) is always kept; unrequested cells and columns are omitted.",
              "items": {
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 200,
              "minItems": 1,
              "type": "array",
            },
            "groupPaging": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "page": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "pageSize": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                },
                "required": [
                  "page",
                ],
                "type": "object",
              },
              "type": "object",
            },
            "keyword": {
              "type": "string",
            },
            "mode": {
              "enum": [
                "rows",
                "primary_keys",
              ],
              "type": "string",
            },
            "page": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer",
            },
            "pageSize": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            "viewID": {
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "action",
            "avID",
          ],
          "type": "object",
        },
        "requiredFields": [
          "avID",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "avID",
        ],
        "tool": "av",
      },
