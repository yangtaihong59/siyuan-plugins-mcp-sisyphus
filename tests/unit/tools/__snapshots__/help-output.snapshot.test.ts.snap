        "fullDocResource": "siyuan://help/action/av/search",
        "guidance": [
          "Find databases with search, inspect structure with get, query paginated records with query, then add_rows or set_cells. A database is not a Markdown table.",
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Searches AV/database definitions by keyword and post-filters unreadable results. Unresolvable matches remain discoverable in unresolvedResults, alongside raw result counts and filtering reasons. Match scope primarily covers AV names plus primary-key fallback results, not arbitrary cell text.",
        "parameters": {
          "additionalProperties": false,
          "description": "Search attribute views by name or primary-key values.",
          "properties": {
            "action": {
              "const": "search",
              "type": "string",
            },
            "excludes": {
              "description": "Optional AV IDs to exclude",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "keyword": {
              "description": "Keyword to search in attribute view names",
              "type": "string",
            },
          },
          "required": [
            "action",
            "keyword",
          ],
          "type": "object",
        },
        "requiredFields": [
          "keyword",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "keyword",
        ],
        "tool": "av",
      },
      "set_cells": {
        "action": "set_cells",
        "example": {
          "action": "set_cells",
          "avID": "20240318112233-avdb001",
          "cells": [
            {
              "columnID": "20240318112233-status1",
              "option": "Done",
              "rowID": "20240318112233-row0001",
              "valueType": "select",
            },
            {
              "columnID": "20240318112233-hours01",
              "number": 5,
              "rowID": "20240318112233-row0001",
              "valueType": "number",
            },
          ],
          "validateOnly": true,
        },
        "examples": [
          {
            "mcp": {
              "action": "set_cells",
              "avID": "20240318112233-avdb001",
              "cells": [
                {
                  "columnID": "20240318112233-status1",
                  "option": "Done",
                  "rowID": "20240318112233-row0001",
                  "valueType": "select",
                },
                {
                  "columnID": "20240318112233-hours01",
                  "number": 5,
                  "rowID": "20240318112233-row0001",
                  "valueType": "number",
                },
              ],
              "validateOnly": true,
            },
            "title": "Set a select and a number cell",
          },
        ],
        "fullDocResource": "siyuan://help/action/av/set_cells",
        "guidance": [
          "Find databases with search, inspect structure with get, query paginated records with query, then add_rows or set_cells. A database is not a Markdown table.",
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Relation values use set_relation, not set_cells; two-way relations may write another database. create_from_template can create a document and stays separate from add_rows.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Use avID + cells[]. Each item requires rowID + columnID + valueType and its matching typed field. For a single-cell write, pass rowID + columnID + valueType directly. rowID must be the AV row item ID stored in value.blockID, not value.id or the bound source block ID. Optional blockID must be a registered database block for this AV if you need to pin a specific block view. valueType="mAsset" accepts assets[]. Relation values are intentionally rejected here; use set_relation so MCP can authorize the destination AV and read back the reverse cell. Cell fields by valueType: text→text:"…"; number→number:9; date→date:"2026-01-31" or epoch ms; checkbox→checked:true; select→option:"在读"; multi_select (column type mSelect)→options:["a","b"]; url/email/phone→url/email/phone:"…"; relation→relationBlockIDs:[…]; mAsset→assets:[{type,content}]. Example: {rowID,columnID,valueType:"select",option:"在读"}.",
        "parameters": {
          "additionalProperties": false,
          "description": "Set one or more cell values in a database. Provide cells/items, or pass rowID + columnID + valueType for a single-cell write.",
