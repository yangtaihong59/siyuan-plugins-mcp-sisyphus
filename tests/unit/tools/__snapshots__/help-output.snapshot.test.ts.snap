              "description": "Registered database block ID for exact context, permission resolution, and UI refresh",
              "type": "string",
            },
            "previousID": {
              "description": "Optional row item ID after which the copied rows are inserted; omit to let SiYuan append them",
              "type": "string",
            },
            "sourceRowIDs": {
              "description": "Canonical AV row item IDs to copy, in source order. Do not pass cell value IDs or bound source block IDs.",
              "items": {
                "type": "string",
              },
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "action",
            "avID",
            "sourceRowIDs",
