      "heading_to_doc": {
        "action": "heading_to_doc",
        "example": {
          "action": "heading_to_doc",
          "headingID": "20240318112233-head001",
          "targetNotebook": "20240318112233-nb00001",
          "targetPath": "/20240318112233-doc0001.sy",
          "validateOnly": true,
        },
        "examples": [
          {
            "description": "The heading and everything under it move into the new document (its ID is the heading ID). targetPath is the source document storage path from document lookup; omit it to land at the notebook root. Rename the new document afterwards if needed.",
            "mcp": {
              "action": "heading_to_doc",
              "headingID": "20240318112233-head001",
              "targetNotebook": "20240318112233-nb00001",
              "targetPath": "/20240318112233-doc0001.sy",
              "validateOnly": true,
            },
            "title": "Split a heading into a child document of its source",
          },
        ],
        "fullDocResource": "siyuan://help/action/document/heading_to_doc",
        "guidance": [
          "For ordinary document file operations, prefer fs(action="ls"|"tree"|"read"|"write"|"search") because it accepts human-readable paths and hides storage paths and IDs.",
        ],
        "hint": "Moves the heading AND everything under it (up to the next heading of the same or higher level) into a new document whose ID is the heading ID; the source document keeps the rest, which is nothing when the heading is its first H1. The new document lands at the target notebook root by default; to make it a child of the source document, pass targetPath = the source document storage path (path from document lookup, e.g. /2024...-abc.sy). The result returns the new document id, title, path, hPath and sourceID.",
        "parameters": {
          "additionalProperties": false,
          "description": "Convert a heading to a separate document",
          "properties": {
            "action": {
              "const": "heading_to_doc",
              "type": "string",
            },
            "headingID": {
              "description": "Heading block ID to convert into a document",
              "type": "string",
            },
            "previousPath": {
              "description": "Existing sibling document storage path ending in .sy in targetNotebook; selects sibling placement. Do not combine with a non-root targetPath.",
              "type": "string",
            },
            "targetNotebook": {
              "description": "Target notebook ID",
              "type": "string",
            },
            "targetPath": {
              "description": "Existing parent document storage path ending in .sy; defaults to / (target notebook root). Not a human-readable path.",
              "type": "string",
            },
          },
          "required": [
            "action",
            "headingID",
            "targetNotebook",
          ],
          "type": "object",
        },
        "requiredFields": [
          "headingID",
          "targetNotebook",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "headingID + targetNotebook",
        ],
        "tool": "document",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
