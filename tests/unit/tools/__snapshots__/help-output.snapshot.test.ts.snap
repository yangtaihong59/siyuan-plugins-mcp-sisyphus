      "export_markdown_snapshot": {
        "action": "export_markdown_snapshot",
        "example": {
          "action": "export_markdown_snapshot",
          "notebookID": "20240318112233-nb00001",
          "roots": [
            "/20240318112233-doc0001.sy",
          ],
        },
        "examples": [
          {
            "description": "roots takes notebook-local storage paths (from document lookup); each documents[] item carries content (the Markdown) plus hashes. Follow the cursor for further pages.",
            "mcp": {
              "action": "export_markdown_snapshot",
              "notebookID": "20240318112233-nb00001",
              "roots": [
                "/20240318112233-doc0001.sy",
              ],
            },
            "title": "Export a document and every descendant as Markdown",
          },
          {
            "mcp": {
              "action": "export_markdown_snapshot",
              "documentIDs": [
                "20240318112233-doc0001",
              ],
              "notebookID": "20240318112233-nb00001",
            },
            "title": "Export specific documents only",
          },
        ],
        "fullDocResource": "siyuan://help/action/file/export_markdown_snapshot",
        "guidance": [],
        "hint": "Provide notebookID plus exactly one of roots or documentIDs. Returns one deterministic, paginated page of Markdown with metadata/content hashes, path conflicts, errors, and an opaque cursor. It never writes the host filesystem and does not create a background job.",
        "parameters": {
          "additionalProperties": false,
          "description": "Export an auditable, paginated Markdown snapshot through SiYuan APIs without writing the host filesystem.",
          "properties": {
            "action": {
              "const": "export_markdown_snapshot",
              "type": "string",
            },
            "cursor": {
              "description": "Opaque continuation cursor returned by the previous page",
              "type": "string",
            },
            "documentIDs": {
              "description": "Explicit document IDs to export",
              "items": {
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 500,
              "minItems": 1,
              "type": "array",
            },
            "limit": {
              "description": "Documents returned in this page (default 20)",
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
            "notebookID": {
              "description": "Notebook ID that owns every exported document",
              "minLength": 1,
              "type": "string",
            },
            "roots": {
              "description": "Notebook-local storage paths to enumerate (use / for notebook roots)",
              "items": {
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "action",
            "notebookID",
          ],
          "type": "object",
        },
        "requiredFields": [
          "notebookID",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "notebookID",
        ],
        "tool": "file",
      },
      "export_md": {
        "action": "export_md",
        "example": {
          "action": "export_md",
          "id": "20240318112233-abc123",
        },
        "fullDocResource": "siyuan://help/action/file/export_md",
        "guidance": [],
        "hint": "Exports one document as Markdown; includeChildren=true appends every descendant document in tree order (max 100), separated by --- and listed in documents. Database blocks are exported as tables of their current view, so view filters and hidden columns apply. For larger trees or per-file output use export_markdown_snapshot with roots.",
        "parameters": {
          "additionalProperties": false,
          "description": "Export document content as Markdown.",
          "properties": {
            "action": {
              "const": "export_md",
              "type": "string",
            },
            "id": {
              "description": "Document ID to export",
              "type": "string",
            },
            "includeChildren": {
              "description": "Also export every descendant document, in tree order (max 100)",
              "type": "boolean",
            },
          },
          "required": [
            "action",
            "id",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id",
        ],
        "tool": "file",
      },
      "export_resources": {
        "action": "export_resources",
        "example": {
          "action": "export_resources",
          "paths": [
            "/assets/example.png",
          ],
        },
        "fullDocResource": "siyuan://help/action/file/export_resources",
        "guidance": [
          "file(action="export_resources") exports the given paths as a ZIP archive, normalizes common asset path formats, and can optionally save the ZIP to a local filesystem path.",
          "file(action="export_resources", outputPath=...) writes to the local filesystem and requires explicit user confirmation before execution.",
          "file(action="extract_doc") exports a document and all its assets into a self-contained uncompressed folder, so AI tools can read the files directly. Prefer this over export_resources when the goal is to inspect attachment content such as images, spreadsheets, or other binary files.",
        ],
        "hint": "Provide one or more existing resource paths. Asset paths like assets/foo.txt are normalized to /data/assets/foo.txt before export. Set outputPath to also copy the exported ZIP to a local filesystem path. With the kernel coordinator enabled, CLI/Node request delivery=download and save the ZIP locally without overwriting existing files; direct kernel clients can use the returned downloadPath through the authenticated getFile API. Using outputPath is high-risk and requires explicit user confirmation. To extract attachments for direct reading without a ZIP archive, prefer extract_doc which produces an uncompressed folder.",
        "parameters": {
          "additionalProperties": false,
          "description": "Export resources as a ZIP archive.",
          "properties": {
            "action": {
              "const": "export_resources",
              "type": "string",
            },
            "delivery": {
              "description": "Kernel response delivery. download returns a manifest for authenticated client-side saving without embedding binary data.",
              "enum": [
                "inline",
                "download",
              ],
              "type": "string",
            },
            "name": {
              "description": "Export file name",
              "type": "string",
            },
            "outputPath": {
              "description": "Optional local absolute or relative filesystem path to save the exported ZIP",
              "type": "string",
            },
            "paths": {
              "description": "Workspace-relative file paths to export (e.g., /data/20240318112233-abc123.sy/ or /assets/foo.png)",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "action",
            "paths",
          ],
          "type": "object",
        },
        "requiredFields": [
          "paths",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "paths",
        ],
        "tool": "file",
      },
      "extract_doc": {
        "action": "extract_doc",
        "example": {
          "action": "extract_doc",
          "id": "20240318112233-abc123",
          "outputDir": "/private/tmp/siyuan-extracted",
        },
        "examples": [
          {
            "description": "If outputDir is omitted, extract_doc defaults to ~/siyuan-extracted/.",
            "mcp": {
              "action": "extract_doc",
              "id": "20240318112233-abc123",
              "outputDir": "/private/tmp/siyuan-extracted",
            },
            "title": "Extract a document to an explicit local output root",
          },
        ],
        "fullDocResource": "siyuan://help/action/file/extract_doc",
        "guidance": [
          "file(action="extract_doc") exports a document and all its assets into a self-contained uncompressed folder, so AI tools can read the files directly. Prefer this over export_resources when the goal is to inspect attachment content such as images, spreadsheets, or other binary files.",
        ],
        "hint": "Use a document ID + optional outputDir. Exports the document markdown and all referenced assets into an uncompressed folder, preserving original filenames. If outputDir is omitted, the default output root is ~/siyuan-extracted/; pass outputDir explicitly for a predictable path such as /private/tmp. With the kernel coordinator enabled, CLI/Node download the manifest into a fresh document directory, preserve existing siblings and reject an existing destination. Direct kernel clients can request delivery=download and save the returned Markdown and asset paths themselves. Without kernel delegation, the existing Node extraction behavior clears the entire output root first and skips unreadable assets. The returned extractedDir is an absolute path ready for direct file access.",
        "parameters": {
          "additionalProperties": false,
          "description": "Export a document and all referenced assets into a self-contained uncompressed folder. Prefer this over export_resources when you need to inspect attachment content.",
          "properties": {
            "action": {
              "const": "extract_doc",
              "type": "string",
            },
            "delivery": {
              "description": "Kernel response delivery. download returns Markdown and asset paths for client-side saving.",
              "enum": [
                "inline",
                "download",
              ],
              "type": "string",
            },
            "id": {
              "description": "Document ID to extract",
              "type": "string",
            },
            "outputDir": {
              "description": "Output root directory. Defaults to ~/siyuan-extracted/ (resolved to absolute path).",
              "type": "string",
            },
          },
          "required": [
            "action",
            "id",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id",
        ],
        "tool": "file",
      },
      "get_doc_assets": {
        "action": "get_doc_assets",
        "example": {
          "action": "get_doc_assets",
          "id": "20240318112233-abc123",
