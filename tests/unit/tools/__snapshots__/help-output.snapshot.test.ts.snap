                "created_asc",
                "type",
              ],
              "type": "string",
            },
            "stripHtml": {
              "description": "Legacy toggle. plainContent is now returned by default; set this when you want to emphasize plain-text-safe downstream parsing while keeping highlighted HTML content.",
              "type": "boolean",
