        },
        "examples": [
          {
            "description": "id is accepted as a convenience alias for ids=[id].",
            "mcp": {
              "action": "word_count",
              "id": "20240318112233-abc123",
            },
            "title": "Get word count for one block",
          },
          {
            "mcp": {
              "action": "word_count",
              "ids": [
                "20240318112233-abc123",
                "20240318112233-def456",
              ],
            },
            "title": "Get word count for multiple blocks",
          },
        ],
        "fullDocResource": "siyuan://help/action/block/word_count",
        "guidance": [
          "To create real SiYuan tags inside markdown content, use the syntax #tag# with both leading and trailing # characters, then verify with tag(action="list", query="tag").",
          "To turn a block into a flashcard, prefer flashcard(action="create_card"). It writes "custom-riff-decks" and registers the riff card together.",
        ],
        "hint": "Provide one or more block IDs to receive aggregate stat data. A document ID counts its whole content but reports blockCount=1 (the document itself); pass the child block IDs for a per-block count. runeCount counts characters; wordCount counts words, where a run of CJK text may count differently from characters.",
        "parameters": {
          "additionalProperties": false,
          "description": "Get word-count statistics for blocks.",
          "properties": {
            "action": {
              "const": "word_count",
              "type": "string",
            },
