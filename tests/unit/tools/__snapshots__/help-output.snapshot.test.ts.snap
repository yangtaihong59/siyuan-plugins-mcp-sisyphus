        "fullDocResource": "siyuan://help/action/block/set_attrs",
        "guidance": [
          "To create real SiYuan tags inside markdown content, use the syntax #tag# with both leading and trailing # characters, then verify with tag(action="list", query="tag").",
          "To turn a block into a flashcard, prefer flashcard(action="create_card"). It writes "custom-riff-decks" and registers the riff card together.",
        ],
        "hint": "Use attrs to write block attributes such as custom metadata. For flashcards, this only writes metadata such as {"custom-riff-decks":"<deck-id>"}; prefer flashcard(action="create_card") when you want a block to become a real review card.",
        "parameters": {
          "additionalProperties": false,
          "description": "Set block attributes.",
          "properties": {
