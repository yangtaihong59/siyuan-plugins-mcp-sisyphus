        "set_filters": {
          "hint": "Provide avID + exact carrier blockID + its current viewID + the complete typed recursive filter tree. [] clears filters; raw readback accepts only the known empty AND-root normalization. First run validateOnly=true.",
          "requiresConfirmation": false,
