    "description": "🖥️ SiYuan system info and utilities: version, current time, network, masked config, notifications, plugin changelog, sync.
Actions (required fields): workspace_info*() · network() · conf() · notify(msg, level) · changelog() · perform_sync*() · get_version() · get_current_time()
* = ask the user to confirm first. action="help" (topic=<action>) returns optional fields, nested shapes, and examples.",
    "overview": {
      "actionSummaries": {
        "changelog": "Reads the bundled plugin CHANGELOG with structured personalizationReview hints. Pass fromVersion after upgrades, version for one exact entry, or includeRaw=true for Markdown.",
        "conf": "Defaults to a navigable summary. Use mode="get" with keyPath to read one config field or subtree at a time, e.g. conf.appearance.mode or conf.langs[0].",
        "get_current_time": "Returns the current system time as {currentTime} epoch milliseconds and {iso} ISO 8601 text.",
        "get_version": "Returns the current SiYuan version as {version}.",
        "network": "Returns masked proxy information only.",
        "notify": "Show an info or error notification in the SiYuan UI. Optional timeout is in milliseconds.",
        "perform_sync": "Triggers SiYuan sync immediately through /api/sync/performSync. This action can change local and remote sync state and requires explicit user confirmation.",
        "workspace_info": "Returns workspace path metadata and current SiYuan version. High-risk: leaks the absolute workspace path; disabled by default and requires explicit user confirmation.",
      },
      "actions": {
        "changelog": {
          "hint": "Reads the bundled plugin CHANGELOG with structured personalizationReview hints. Pass fromVersion after upgrades, version for one exact entry, or includeRaw=true for Markdown.",
          "requiresConfirmation": false,
        },
        "conf": {
          "hint": "Defaults to a navigable summary. Use mode="get" with keyPath to read one config field or subtree at a time, e.g. conf.appearance.mode or conf.langs[0].",
          "requiresConfirmation": false,
        },
        "get_current_time": {
          "hint": "Returns the current system time as {currentTime} epoch milliseconds and {iso} ISO 8601 text.",
          "requiresConfirmation": false,
        },
        "get_version": {
          "hint": "Returns the current SiYuan version as {version}.",
          "requiresConfirmation": false,
        },
        "network": {
          "hint": "Returns masked proxy information only.",
          "requiresConfirmation": false,
        },
        "notify": {
          "hint": "Show an info or error notification in the SiYuan UI. Optional timeout is in milliseconds.",
          "requiresConfirmation": false,
        },
        "perform_sync": {
          "hint": "Triggers SiYuan sync immediately through /api/sync/performSync. This action can change local and remote sync state and requires explicit user confirmation.",
          "requiresConfirmation": true,
        },
        "workspace_info": {
          "hint": "Returns workspace path metadata and current SiYuan version. High-risk: leaks the absolute workspace path; disabled by default and requires explicit user confirmation.",
          "requiresConfirmation": true,
        },
      },
      "advancedActions": [
        "workspace_info",
        "network",
        "notify",
        "perform_sync",
      ],
      "commonActions": [
        "conf",
        "changelog",
        "get_version",
        "get_current_time",
      ],
      "detailsHint": "Call system(action="help", topic="<actionName>") for required fields, shapes, and a minimal example.",
      "guidance": [
        "Most system actions in this tool are read-only; perform_sync is the mutating exception and requires explicit user confirmation before execution.",
        "system(action="workspace_info") exposes the workspace path and is high-risk; it is disabled by default.",
        "system(action="perform_sync") triggers SiYuan sync immediately; it does not modify sync provider settings.",
        "system(action="conf") returns masked configuration, not raw secrets.",
        "Use system(action="changelog", fromVersion="<previousVersion>") after plugin upgrades to see whether old personalized settings, rules, memory, or connection snippets need review.",
        "Use system(action="conf", mode="summary") first, then mode="get" + keyPath such as conf.appearance.mode or conf.langs[0].",
      ],
      "helpResources": [
        "siyuan://help/action/system/{action}",
        "siyuan://help/tool-overview",
        "siyuan://help/examples",
        "siyuan://help/ai-layout-guide",
      ],
      "requiresConfirmation": [
        "workspace_info",
        "perform_sync",
      ],
      "sharedTopics": [
        "ai-layout-guide",
      ],
      "tool": "system",
    },
