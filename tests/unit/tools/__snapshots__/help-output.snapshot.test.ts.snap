  "fs": {
    "actions": {
      "ls": {
        "action": "ls",
        "example": {
          "action": "ls",
          "path": "/Notebook/Folder/Doc",
        },
        "fullDocResource": "siyuan://help/action/fs/ls",
        "guidance": [
          "fs paths are human-readable workspace paths. Prefer /Notebook/Folder/Doc so resolution is unambiguous; a notebook-omitted path such as /Folder/Doc works only when it uniquely matches across readable notebooks. fs outputs canonical paths with the notebook name and hides notebook IDs, block IDs, and storage paths.",
          "fs(action="reorder") applies a complete manual order to every visible direct child under path and switches the notebook to custom sorting. Read fs.ls first and include each returned child path exactly once.",
        ],
        "hint": "Use a human-readable path. "/" lists readable notebook roots; /Notebook or /Notebook/Folder lists direct child documents.",
        "parameters": {
          "additionalProperties": false,
          "description": "List direct child documents using human-readable paths.",
          "properties": {
            "action": {
              "const": "ls",
              "type": "string",
            },
            "path": {
              "description": "Human-readable workspace path. Prefer including the notebook name (e.g., /Notebook or /Notebook/Folder) for unambiguous resolution; a notebook-omitted path is accepted only when it uniquely matches across readable notebooks. Use / to list all readable notebooks.",
              "type": "string",
            },
          },
          "required": [
            "action",
            "path",
          ],
          "type": "object",
        },
