      "set_column_options": {
        "action": "set_column_options",
        "example": {
          "action": "set_column_options",
          "avID": "<avID>",
          "keyID": "<keyID>",
          "options": [
            {
              "name": "Research",
            },
          ],
        },
        "fullDocResource": "siyuan://help/action/av/set_column_options",
        "guidance": [
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Dangerous: use avID + keyID + the complete options array for a select or mSelect key. This is a replacement, not a patch: omitted names are removed. First call the same action with validateOnly=true; after confirmation submit the returned expectedStateHash and the returned requestId. If new names are observed in SiYuan append order, MCP reports intermediate_option_order and requires a new preflight before any explicit reorder.",
        "parameters": {
          "additionalProperties": false,
          "description": "Replace one select or multi-select column's complete option list. Read the current options first: omitted entries are not preserved.",
          "properties": {
            "action": {
              "const": "set_column_options",
              "type": "string",
            },
            "avID": {
              "description": "Attribute view ID",
              "type": "string",
            },
            "blockID": {
              "description": "Registered database block ID for exact context, permission resolution, and UI refresh",
              "type": "string",
            },
            "keyID": {
              "description": "Select or multi-select column key ID",
              "type": "string",
            },
            "options": {
              "description": "Complete desired option list, which may be empty. This is not a patch: omit no existing option unless its removal is intentional.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "description": "Optional SiYuan option color token",
                    "type": "string",
                  },
                  "desc": {
                    "description": "Optional option description",
                    "type": "string",
                  },
                  "name": {
                    "description": "Option label; empty option names are rejected before the transaction.",
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                ],
                "type": "object",
              },
              "type": "array",
            },
          },
          "required": [
            "action",
            "avID",
            "keyID",
            "options",
          ],
          "type": "object",
        },
        "requiredFields": [
          "avID",
          "keyID",
          "options",
        ],
        "requiresConfirmation": true,
        "shapes": [
          "avID + keyID + options",
        ],
        "tool": "av",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
      "set_new_item_templates": {
        "action": "set_new_item_templates",
        "example": {
          "action": "set_new_item_templates",
          "avID": "<avID>",
          "blockID": "<blockID>",
          "defaultTemplateID": "<defaultTemplateID>",
          "templates": [
            {
              "id": "20240318112233-abc123",
            },
          ],
        },
        "fullDocResource": "siyuan://help/action/av/set_new_item_templates",
        "guidance": [
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Dangerous complete replacement of ordered native new-item templates. Pass every template and defaultTemplateID, not a patch. MCP captures a canonical complete-template preimage, validates each key and select/mSelect option against the raw AV, performs one native transaction, and verifies order, default, and all remaining template fields through getAttributeView. Missing options are rejected rather than added or silently pruned.",
        "parameters": {
          "additionalProperties": false,
          "description": "Replace the complete ordered native new-item-template configuration after checking each field against the current AV schema.",
          "properties": {
            "action": {
              "const": "set_new_item_templates",
              "type": "string",
            },
            "avID": {
              "description": "Attribute view ID",
              "pattern": "^\\d{14}-[a-z0-9]{7}$",
              "type": "string",
            },
            "blockID": {
              "description": "Materialized database block used for permission and transaction context",
              "pattern": "^\\d{14}-[a-z0-9]{7}$",
              "type": "string",
            },
            "defaultTemplateID": {
              "anyOf": [
                {
                  "pattern": "^\\d{14}-[a-z0-9]{7}$",
                  "type": "string",
                },
                {
                  "const": "",
                  "type": "string",
                },
              ],
              "description": "Default template ID, or empty to clear it; required because this replaces the complete configuration",
            },
            "templates": {
              "description": "Complete ordered replacement template array",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "contentTemplatePath": {
                    "description": "Native content-template path for document targets",
                    "type": "string",
                  },
                  "fieldValues": {
                    "additionalProperties": {
                      "additionalProperties": false,
                      "properties": {
                        "mode": {
                          "description": "Native new-item field-value mode",
                          "enum": [
                            "static",
                            "currentTime",
                          ],
                          "type": "string",
                        },
                        "value": {
                          "additionalProperties": {},
                          "description": "Native AV value payload; omitted for currentTime",
                          "type": "object",
                        },
                      },
                      "required": [
                        "mode",
                      ],
                      "type": "object",
                    },
                    "description": "Defaults keyed by AV key ID",
                    "type": "object",
                  },
                  "icon": {
                    "description": "Document template icon",
                    "type": "string",
                  },
                  "id": {
                    "description": "Stable new-item template ID",
                    "pattern": "^\\d{14}-[a-z0-9]{7}$",
                    "type": "string",
                  },
                  "name": {
                    "description": "Template name; SiYuan trims surrounding whitespace",
                    "minLength": 1,
                    "type": "string",
                  },
                  "primaryKeyTemplate": {
                    "description": "Native Go-template primary-key source",
                    "type": "string",
                  },
                  "saveLocation": {
                    "additionalProperties": false,
                    "description": "Document target location; omitted means inherit SiYuan's document-create configuration",
                    "properties": {
                      "boxID": {
                        "type": "string",
                      },
                      "pathTemplate": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "pathTemplate",
                    ],
                    "type": "object",
                  },
                  "targetType": {
                    "description": "Whether creation makes a detached row or a document-bound row",
                    "enum": [
                      "detached",
                      "document",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "name",
                  "targetType",
                ],
                "type": "object",
              },
              "type": "array",
            },
          },
          "required": [
            "action",
            "avID",
            "blockID",
            "templates",
            "defaultTemplateID",
          ],
          "type": "object",
        },
        "requiredFields": [
          "avID",
          "blockID",
          "templates",
          "defaultTemplateID",
        ],
        "requiresConfirmation": true,
        "shapes": [
          "avID + blockID + templates + defaultTemplateID",
        ],
        "tool": "av",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
      "set_relation": {
        "action": "set_relation",
        "example": {
          "action": "set_relation",
          "avID": "<avID>",
          "blockID": "<blockID>",
          "itemID": "<itemID>",
          "keyID": "<keyID>",
          "relatedItemIDs": [
            "<relatedItemIDsItem>",
          ],
        },
        "fullDocResource": "siyuan://help/action/av/set_relation",
        "guidance": [
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "Relation values use set_relation, not set_cells; two-way relations may write another database. create_from_template can create a document and stays separate from add_rows.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Dangerous complete replacement of one relation cell. blockID is the verified source database carrier; itemID and relatedItemIDs are AV row item IDs, never bound document block IDs. An empty relatedItemIDs array clears the relation. MCP authorizes destination writes and verifies source plus two-way reverse cells without retrying an unknown response.",
        "parameters": {
          "additionalProperties": false,
          "description": "Set or clear one relation cell by AV item IDs, then verify the two-way reverse cell when configured.",
          "properties": {
            "action": {
              "const": "set_relation",
              "type": "string",
            },
            "avID": {
              "description": "Attribute view ID",
              "pattern": "^\\d{14}-[a-z0-9]{7}$",
              "type": "string",
            },
            "blockID": {
              "description": "Verified source database block; relation writes never infer this from a row's bound block",
              "pattern": "^\\d{14}-[a-z0-9]{7}$",
              "type": "string",
            },
            "itemID": {
              "description": "AV row item ID; never the bound document block ID",
              "pattern": "^\\d{14}-[a-z0-9]{7}$",
              "type": "string",
            },
            "keyID": {
              "description": "Relation key ID",
              "pattern": "^\\d{14}-[a-z0-9]{7}$",
              "type": "string",
            },
            "relatedItemIDs": {
              "description": "Target AV row item IDs; an empty array clears the relation",
              "items": {
                "pattern": "^\\d{14}-[a-z0-9]{7}$",
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "action",
            "avID",
            "blockID",
            "itemID",
            "keyID",
            "relatedItemIDs",
          ],
          "type": "object",
        },
        "requiredFields": [
          "avID",
          "blockID",
          "itemID",
          "keyID",
          "relatedItemIDs",
        ],
        "requiresConfirmation": true,
        "shapes": [
          "avID + blockID + itemID + keyID + relatedItemIDs",
        ],
        "tool": "av",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
      "update_view": {
        "action": "update_view",
        "example": {
          "action": "update_view",
          "avID": "20240318112233-avdb001",
          "blockID": "20240318112233-block01",
          "filters": [
            {
              "column": "20240318112233-status1",
              "operator": "=",
              "value": {
                "mSelect": [
                  {
                    "content": "待办",
                  },
                ],
                "type": "select",
              },
            },
          ],
          "validateOnly": true,
          "viewID": "20240318112233-view001",
        },
        "examples": [
          {
            "description": "Replace the IDs with the exact database, carrier, selected view, and existing select-column IDs returned by get/query. Use an actual option name. A leaf has no combination or filters fields. Commit once with unchanged business arguments, validateOnly=false, and the returned requestId and expectedStateHash.",
            "mcp": {
              "action": "update_view",
              "avID": "20240318112233-avdb001",
              "blockID": "20240318112233-block01",
              "filters": [
                {
                  "column": "20240318112233-status1",
                  "operator": "=",
                  "value": {
                    "mSelect": [
                      {
                        "content": "待办",
                      },
                    ],
                    "type": "select",
                  },
                },
              ],
              "validateOnly": true,
              "viewID": "20240318112233-view001",
            },
            "title": "Preflight a select leaf filter",
          },
          {
            "description": "Each group contains only combination and filters. Its children are groups or leaf conditions; column/operator/value belong only on leaves.",
            "mcp": {
              "action": "update_view",
              "avID": "20240318112233-avdb001",
              "blockID": "20240318112233-block01",
              "filters": [
                {
                  "combination": "and",
                  "filters": [
                    {
                      "combination": "or",
                      "filters": [
                        {
                          "column": "20240318112233-status1",
                          "operator": "=",
                          "value": {
                            "mSelect": [
                              {
                                "content": "待办",
                              },
                            ],
                            "type": "select",
                          },
                        },
                        {
                          "column": "20240318112233-status1",
                          "operator": "=",
                          "value": {
                            "mSelect": [
                              {
                                "content": "进行中",
                              },
                            ],
                            "type": "select",
                          },
                        },
                      ],
                    },
                  ],
                },
              ],
              "validateOnly": true,
              "viewID": "20240318112233-view001",
            },
            "title": "Preflight nested filter groups",
          },
        ],
        "fullDocResource": "siyuan://help/action/av/update_view",
        "guidance": [
          "Explicit viewID selects only the read target; it never switches the database carrier. Returned viewID and selectionSource identify the actual selection; selectionFallback reports kernel-default fallback.",
          "update_view requires avID + exact carrier blockID + its currently selected viewID. Omitted settings stay unchanged. filters/sorts/group/columnOrder replace complete settings; columnVisibility patches only named columns.",
          "filters:[] and sorts:[] clear settings; group:{field:""} clears grouping. columnOrder includes every current view field, including hidden fields. Duplicate IDs, null and unknown settings are rejected.",
          "Filter leaves use column/operator/value and omit combination/filters. Group nodes use only combination and filters; never mix group and leaf fields in one node.",
          "update_view sends one transaction after complete validation, then verifies every requested setting and protected configuration. This is not a guarantee of kernel atomicity. Unchanged requests return no_change without a transaction.",
          "Follow enabled nextSteps using real returned IDs. Completed pages never suggest another page. Writes always require user intent and the applicable strict preflight.",
        ],
        "hint": "Use avID + blockID + current viewID and at least one of filters, sorts, group, columnVisibility:[{columnID,hidden}], columnOrder:[columnID]. Arrays replace except visibility, which changes listed columns only. Empty visibility alone is rejected. Filter nodes must not mix group fields (combination/filters) with leaf fields (column/operator/value); groups contain only combination and filters. Preflight validates all configurations before one transaction; readback protects every unrequested property.",
        "parameters": {
          "additionalProperties": false,
          "description": "Update one carrier-selected view in a single transaction; omitted configurations remain unchanged.",
          "properties": {
            "action": {
              "const": "update_view",
              "type": "string",
            },
            "avID": {
              "minLength": 1,
              "type": "string",
            },
            "blockID": {
              "description": "Exact NodeAttributeView carrier block ID; kernel fallback is not permitted",
              "minLength": 1,
              "type": "string",
            },
            "columnOrder": {
              "description": "Complete current view field order, including hidden fields",
              "items": {
                "minLength": 1,
                "type": "string",
              },
              "minItems": 1,
              "type": "array",
            },
            "columnVisibility": {
              "description": "Modify only listed columns; duplicate IDs are rejected",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "columnID": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "hidden": {
                    "type": "boolean",
                  },
                },
                "required": [
                  "columnID",
                  "hidden",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "filters": {
              "description": "Complete replacement; [] clears filters",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "column": {
                    "description": "Existing AV key ID for a leaf filter",
