        ],
        "hint": "Use notebook + path, where path is a storage path such as / or /20240318112233-abc123.sy.",
        "parameters": {
          "additionalProperties": false,
          "description": "Get document tree",
          "properties": {
            "action": {
              "const": "list_tree",
              "type": "string",
            },
            "maxDepth": {
