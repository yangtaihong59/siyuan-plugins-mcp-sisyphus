  "file": {
    "actions": {
      "audit_image_refs": {
        "action": "audit_image_refs",
        "example": {
          "action": "audit_image_refs",
          "expectedRefs": [
            "<expectedRefsItem>",
          ],
          "id": "20240318112233-abc123",
        },
        "fullDocResource": "siyuan://help/action/file/audit_image_refs",
        "guidance": [
          "file(action="audit_image_refs") compares caller-supplied expected image references with SiYuan's read-only direct image asset list. It uses multiset basename matching: every occurrence is preserved and matched once, including duplicate refs and different paths with the same basename. It ignores SiYuan timestamp/id filename suffixes, never reads local .sy files, and never repairs content.",
        ],
        "hint": "Use id + expectedRefs from source or preprocessed Markdown. The action reads only SiYuan's direct image asset references over HTTP and returns expectedRefs, actualRefs, missingRefs, extraRefs, counts, and ok. Matching is a multiset by basename: each occurrence is preserved and consumed once, so duplicates and same-basename paths are not silently merged. It ignores SiYuan timestamp/id suffixes; it does not read local files or repair imports.",
        "parameters": {
          "additionalProperties": false,
          "description": "Compare expected imported image references with SiYuan document image references. Read-only; no local file access or repair.",
          "properties": {
            "action": {
              "const": "audit_image_refs",
              "type": "string",
            },
            "expectedRefs": {
              "description": "Expected image references from source Markdown; no local file is read.",
              "items": {
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 4096,
              "type": "array",
            },
            "id": {
              "description": "Document ID whose direct image references should be inspected.",
              "type": "string",
            },
          },
          "required": [
            "action",
            "id",
            "expectedRefs",
          ],
          "type": "object",
        },
        "requiredFields": [
          "id",
          "expectedRefs",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "id + expectedRefs",
        ],
        "tool": "file",
      },
      "create_template": {
        "action": "create_template",
        "example": {
          "action": "create_template",
          "markdown": "# .action{.title}

## Summary
",
          "path": "reports/monthly.md",
        },
        "examples": [
          {
            "mcp": {
              "action": "create_template",
              "markdown": "# .action{.title}

## Summary
",
              "path": "reports/monthly.md",
            },
            "title": "Create a nested Markdown template",
          },
        ],
        "fullDocResource": "siyuan://help/action/file/create_template",
        "guidance": [
          "file(action="create_template"|"update_template") writes Markdown templates through SiYuan’s /api/file/putFile workspace API; it does not write data/templates through the local filesystem.",
          "file(action="save_doc_as_template") saves an existing document as a root-level template after read-permission checks; use create_template when you need a nested template path.",
        ],
        "hint": "Use path + markdown to create a Markdown template under data/templates. overwrite=false by default returns template_exists when the path already exists; pass overwrite=true to replace it.",
        "parameters": {
          "additionalProperties": false,
          "description": "Create a Markdown template under data/templates through SiYuan’s workspace file API.",
          "properties": {
            "action": {
              "const": "create_template",
              "type": "string",
            },
            "markdown": {
              "description": "Full Markdown template source to write.",
              "type": "string",
            },
            "overwrite": {
              "description": "When true, replace an existing template at the same path. Defaults to false.",
              "type": "boolean",
            },
            "path": {
              "description": "Template path to create under data/templates. Accepts relative paths such as reports/monthly.md.",
              "type": "string",
            },
          },
          "required": [
            "action",
            "path",
            "markdown",
          ],
          "type": "object",
        },
        "requiredFields": [
          "path",
          "markdown",
        ],
        "requiresConfirmation": false,
        "shapes": [
          "path + markdown",
        ],
        "tool": "file",
        "writeWorkflow": [
          "Confirm the user-authorized target and operation scope.",
          "Call the same action with validateOnly=true to obtain preflight.commitArgs.",
          "Read the returned preview (targets, changes, risk) and confirm it matches the intended change; if not, do not commit. preview="full" returns complete before/after text.",
          "Copy preflight.commitArgs unchanged as the next call arguments; do not edit requestId, hashes, or business fields.",
          "Read the target back or inspect the returned receipt before reporting success.",
        ],
      },
